# aprntc — environment configuration (TEMPLATE)
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# .env is gitignored; .env.example is committed as the documented template.

# ─── BytePlus ModelArk (LLM: policy + judge) ────────────────────────────────
# OpenAI-compatible endpoint. Bearer auth.
ARK_API_KEY=
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# Model identifiers (model name OR endpoint-id "ep-..." from the ModelArk console).
# Policy = the agent model; Judge = recused, MUST differ from policy.
APRNTC_POLICY_MODEL=        # e.g. Seed-2.0-pro model-id or endpoint-id
APRNTC_JUDGE_MODEL=         # e.g. DeepSeek-V4-pro model-id or endpoint-id

# ─── Experience Memory — vector DB backend ─────────────────────────────────
# Default = local SQLite + cosine, works offline (no creds). Pick a different
# backend by changing the URL scheme. See docs/VECTOR_DB.md for the full guide.
#   local:///./aprntc_memory.db                     ← default (no deps)
#   chroma:///./aprntc_chroma                       ← needs [chroma] extra
#   byteplus://collection/index                     ← needs [byteplus] + VIKINGDB_* below
#   pinecone://index-name                           ← needs [pinecone] + PINECONE_API_KEY
#   aws://search-mydomain.us-east-1.es.amazonaws.com/index  ← needs [aws] + AWS_* below
APRNTC_VECTOR_DB_URL=local:///./aprntc_memory.db

# ─── BytePlus VikingDB (only if APRNTC_VECTOR_DB_URL=byteplus://…) ─────────
# AK/SK for Volcengine Signature-V4 signing.
VIKINGDB_AK=
VIKINGDB_SK=
VIKINGDB_REGION=ap-southeast-1
VIKINGDB_DATA_HOST=api-vikingdb.vikingdb.ap-southeast-1.bytepluses.com
VIKINGDB_CONTROL_HOST=vikingdb.ap-southeast-1.byteplusapi.com

# ─── Pinecone (only if APRNTC_VECTOR_DB_URL=pinecone://…) ──────────────────
PINECONE_API_KEY=
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ─── AWS OpenSearch (only if APRNTC_VECTOR_DB_URL=aws://…) ─────────────────
AWS_OPENSEARCH_USER=
AWS_OPENSEARCH_PASSWORD=
AWS_OPENSEARCH_USE_SSL=true

# ─── Optional provider keys (model-agnostic adapters; leave blank if unused) ─
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=

# ─── Local infra ────────────────────────────────────────────────────────────
# Trajectory Store DSN (SQLite to bootstrap; Postgres later).
APRNTC_DB_URL=sqlite:///./aprntc.db

#Google OAuth 2.0 credentials for user authentication (if using Google SSO).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
APRNTC_SESSION_SECRET=